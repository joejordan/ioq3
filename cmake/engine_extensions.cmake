# Generates each executable's engineExtensions table (code/qcommon/hooks.h)
# from the extensions add_engine_extension() linked into it
# (utils/engine_extension.cmake), and the line naming them that the engine
# prints at startup, which also says in the binary what's linked in. With
# none, the table and the line are empty, and the engine runs as it would
# without the hooks.

# hooks.c's MAX_ENGINE_EXTENSIONS
set(MAX_ENGINE_EXTENSIONS 32)

function(add_engine_extensions_table EXECUTABLE)
    get_property(EXTENSIONS GLOBAL PROPERTY ENGINE_EXTENSIONS_${EXECUTABLE})
    list(LENGTH EXTENSIONS COUNT)
    if(COUNT GREATER MAX_ENGINE_EXTENSIONS)
        message(FATAL_ERROR "${EXECUTABLE} links ${COUNT} engine extensions, over the engine's ${MAX_ENGINE_EXTENSIONS}")
    endif()
    set(DECLARATIONS "")
    set(ENTRIES "")
    foreach(NAME IN LISTS EXTENSIONS)
        string(APPEND DECLARATIONS "extern const engineExtension_t ${NAME}_extension;\n")
        string(APPEND ENTRIES "\t&${NAME}_extension,\n")
    endforeach()
    set(LINE "")
    # by count: if(EXTENSIONS) is false for a lone extension named n or off
    if(COUNT GREATER 0)
        list(JOIN EXTENSIONS " " NAMES)
        set(LINE "Engine extensions: ${NAMES}")
    endif()

    set(TABLE ${CMAKE_BINARY_DIR}/extensions/${EXECUTABLE}_extensions.c)
    file(CONFIGURE OUTPUT ${TABLE} CONTENT [[
// Generated by engine_extensions.cmake. Do not edit.
#include "@SOURCE_DIR@/qcommon/q_shared.h"
#include "@SOURCE_DIR@/qcommon/qcommon.h"

@DECLARATIONS@
const engineExtension_t *const engineExtensions[] = {
@ENTRIES@	NULL
};

const char engineExtensionsLine[] = "@LINE@";
]] @ONLY)
    target_sources(${EXECUTABLE} PRIVATE ${TABLE})
endfunction()

if(TARGET ${CLIENT_BINARY})
    add_engine_extensions_table(${CLIENT_BINARY})
endif()

if(TARGET ${SERVER_BINARY})
    add_engine_extensions_table(${SERVER_BINARY})
endif()
