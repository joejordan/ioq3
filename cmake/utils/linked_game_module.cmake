include_guard(GLOBAL)

# add_linked_game_module(<module>
#     [GAME_DIRECTORY <directory>]
#     [DEFINITIONS <definition>...]
#     [INCLUDE_DIRECTORIES <directory>...]
#     [COMPILE_OPTIONS <option>...]
#     SOURCES <source>...)
#
# Builds a game module (${GAME_MODULE}, ${CGAME_MODULE} or ${UI_MODULE}) for
# linking into the executables: the client gets every module, the dedicated
# server gets each ${GAME_MODULE}. VM_Create finds it in vm_linkedModules
# (linked_game_modules.cmake) and uses it instead of a dll or .qvm.
#
# Without GAME_DIRECTORY, the module is the base game's, used in whatever
# directory com_basegame names. With it, the module is used when that game
# directory is the current one, as missionpack's are; one module of each name
# can be linked for the base game and one for each directory. The module's ID
# is <module> for the base game and <directory>_<module> otherwise, made a C
# identifier, and its object library is the target <ID>_linked.
#
# The modules share code (q_shared.c, bg_*.c) with each other and with the
# engine, and each defines vmMain and dllEntry. So the sources are compiled
# twice: once to list the external symbols they define, then again with a
# header forced in that renames each one to <ID>_<symbol>.
#
# Game code expects fresh data each time it's loaded. Marker objects before
# and after the module's objects bound its data and bss, which the linker
# lays out in object order, so VM_Create can reset them. That needs the
# module built without LTO and without common symbols.
function(add_linked_game_module MODULE)
    cmake_parse_arguments(ARG "" "GAME_DIRECTORY" "DEFINITIONS;INCLUDE_DIRECTORIES;COMPILE_OPTIONS;SOURCES" ${ARGN})

    if(MSVC)
        message(FATAL_ERROR "Linking game modules into the executable isn't supported with MSVC")
    endif()
    if(NOT CMAKE_NM)
        message(FATAL_ERROR "Linking game modules into the executable needs nm")
    endif()
    if(NOT "${ARG_GAME_DIRECTORY}" STREQUAL "")
        string(MAKE_C_IDENTIFIER "${ARG_GAME_DIRECTORY}_${MODULE}" ID)
        set(FOR " for ${ARG_GAME_DIRECTORY}")
    else()
        set(ID ${MODULE})
        set(FOR " for the base game")
    endif()
    get_property(LINKED_MODULES GLOBAL PROPERTY LINKED_GAME_MODULES)
    if(ID IN_LIST LINKED_MODULES)
        message(FATAL_ERROR "Only one ${MODULE}${FOR} can be linked into the executable (its ID, ${ID}, is taken)")
    endif()

    set(SCAN_TARGET ${ID}_linked_symbols)
    set(TARGET ${ID}_linked)
    set(LINKED_DIR ${CMAKE_BINARY_DIR}/linked)
    set(SYMBOLS_HEADER ${LINKED_DIR}/${ID}_symbols.h)

    foreach(MARKER Begin End)
        file(CONFIGURE OUTPUT ${LINKED_DIR}/${ID}_linked${MARKER}.c CONTENT [[
// Generated by linked_game_module.cmake. Do not edit.
unsigned char @ID@_linkedData@MARKER@[1] = { 1 };
unsigned char @ID@_linkedBss@MARKER@[1];
]] @ONLY)
    endforeach()

    add_library(${SCAN_TARGET} OBJECT ${ARG_SOURCES})
    add_library(${TARGET} OBJECT
        ${LINKED_DIR}/${ID}_linkedBegin.c # first, so its data comes first
        ${ARG_SOURCES}
        ${SYMBOLS_HEADER}
        ${LINKED_DIR}/${ID}_linkedEnd.c)

    foreach(PASS_TARGET ${SCAN_TARGET} ${TARGET})
        target_compile_definitions( ${PASS_TARGET} PRIVATE ${ARG_DEFINITIONS})
        target_include_directories( ${PASS_TARGET} PRIVATE ${ARG_INCLUDE_DIRECTORIES})
        target_compile_options(     ${PASS_TARGET} PRIVATE -fno-common)
        if(APPLE)
            # Mach-O puts zeroed statics in __bss, apart from __common, so
            # keep the module's zeroed data in __data, which the reset
            # restores (the bss markers stay zero-fill)
            target_compile_options( ${PASS_TARGET} PRIVATE -fno-zero-initialized-in-bss)
        endif()
        set_target_properties(      ${PASS_TARGET} PROPERTIES INTERPROCEDURAL_OPTIMIZATION OFF)
    endforeach()

    add_custom_command(
        OUTPUT ${SYMBOLS_HEADER}
        COMMAND ${CMAKE_COMMAND}
            -DNM=${CMAKE_NM}
            -DMODULE=${ID}
            "-DOBJECTS=$<JOIN:$<TARGET_OBJECTS:${SCAN_TARGET}>,|>"
            -DOUTPUT=${SYMBOLS_HEADER}
            -P ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/linked_game_symbols.cmake
        DEPENDS ${SCAN_TARGET} $<TARGET_OBJECTS:${SCAN_TARGET}>
            ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/linked_game_symbols.cmake
        COMMENT "Listing the symbols of the linked ${MODULE}${FOR}"
        VERBATIM)

    target_compile_options(${TARGET} PRIVATE -include ${SYMBOLS_HEADER})
    # after the renaming header, so a header these force in declares the
    # renamed names
    target_compile_options(${SCAN_TARGET} PRIVATE ${ARG_COMPILE_OPTIONS})
    target_compile_options(${TARGET} PRIVATE ${ARG_COMPILE_OPTIONS})

    if(APPLE)
        set_source_files_properties(
            ${LINKED_DIR}/${ID}_linkedBegin.c ${LINKED_DIR}/${ID}_linkedEnd.c
            TARGET_DIRECTORY ${TARGET}
            PROPERTIES COMPILE_OPTIONS -fzero-initialized-in-bss)
    endif()

    set_target_properties(${TARGET} PROPERTIES
        LINKED_GAME_MODULE_NAME ${MODULE}
        LINKED_GAME_DIRECTORY "${ARG_GAME_DIRECTORY}")
    set_property(GLOBAL APPEND PROPERTY LINKED_GAME_MODULES ${ID})
    if(MODULE STREQUAL GAME_MODULE)
        set_property(GLOBAL APPEND PROPERTY LINKED_GAME_SERVER_MODULES ${ID})
    endif()
endfunction()
