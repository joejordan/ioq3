/////////////////////////////////////////////////////////////////////////////
//
// Version, which Explorer shows in the executable's properties, from the
// header cmake/platforms/windows.cmake writes, in UTF-8
//
#ifdef WINDOWS_VERSION_HEADER
#pragma code_page(65001)
#include WINDOWS_VERSION_HEADER

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_NUMBERS
 PRODUCTVERSION VERSION_NUMBERS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
#ifdef DEDICATED
            VALUE "FileDescription", VERSION_SERVER_NAME
#else
            VALUE "FileDescription", VERSION_APP_NAME
#endif
            VALUE "FileVersion", VERSION_STRING
            VALUE "LegalCopyright", VERSION_COPYRIGHT
            VALUE "ProductName", VERSION_APP_NAME
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
#endif

