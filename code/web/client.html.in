<!DOCTYPE html><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>@WEB_PAGE_TITLE@</title>
<link rel=icon href="@CLIENT_NAME@.png">
<link rel=manifest href="@CLIENT_NAME@.webmanifest">
<style>
html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: rgb(0, 0, 0); }
/* Fill the page. SDL3 resizes the canvas to its CSS size as the page
   changes, and the engine follows without a restart. dvh follows mobile
   browsers' toolbars. SDL3 needs no border or padding on the canvas. */
canvas { display: block; width: 100vw; height: 100dvh; border: 0; padding: 0; }
canvas:focus { outline: none; }
/* The page's word over the game: the download's progress, or an error.
   Clicks go through it to the canvas, where SDL asks for the pointer. */
#status, #hints { position: fixed; pointer-events: none; font: 18px/1.4 system-ui, sans-serif; color: rgb(235, 235, 235); text-align: center; }
#status { inset: 0; display: grid; place-items: center; }
#status[hidden] { display: none; }
#status > div, .hint { background: rgba(0, 0, 0, 0.7); border-radius: 8px; }
#status > div { padding: 16px 24px; max-width: min(32em, 80vw); }
#status progress { display: block; width: 100%; margin-top: 8px; }
#status progress[hidden] { display: none; }
/* an error stays, and its words can be copied */
#status.error { pointer-events: auto; user-select: text; }
/* The page's hints near the top centre, where a browser says how to leave
   fullscreen: how to leave it and come back, and "Click to play"; #status
   is the download's and errors'. Clicks go through them. A hint fades in
   from nothing and, faded out and emptied, takes no room */
#hints { top: 48px; left: 16px; right: 16px; display: flex; flex-direction: column; align-items: center; gap: 8px; }
.hint { padding: 8px 16px; opacity: 0; transition: opacity 0.4s; }
.hint:empty { display: none; }
.hint.shown { opacity: 1; }
@starting-style { .hint.shown { opacity: 0; } }
</style>

<!-- The game takes keys only while its canvas has focus (the engine sets
     SDL_HINT_EMSCRIPTEN_KEYBOARD_ELEMENT), so keys typed into the rest of
     the page stay there; tabindex lets the canvas have focus -->
<canvas id=canvas tabindex=0></canvas>
<div id=status hidden><div><span></span><progress hidden></progress></div></div>
<div id=hints><div id=hint class=hint></div><div id=play class=hint></div></div>

<script type=module>
// These strings are set in the generated HTML file in the build directory.
const CLIENT_NAME = '@CLIENT_NAME@';
const BASEGAME = '@BASEGAME@';
const EMSCRIPTEN_PRELOAD_FILE = '@EMSCRIPTEN_PRELOAD_FILE@' === 'ON';
const MIN_WEBGL_VERSION = Number('@WEB_MIN_WEBGL_VERSION@');

// Path or URL containing the client engine .js, .wasm, and possibly .data.
let enginePath = './';
// Path or URL containing fs_game directories.
let dataPath = './';
// Path or URL for config file that specifies the files to load for each fs_game.
let configFilename = `./${CLIENT_NAME}-config.json`;

if (window.location.protocol === 'file:') throw new Error(`Unfortunately browser security restrictions prevent loading wasm from a file: URL. This file must be loaded from a web server. The easiest way to do this is probably to use Python\'s built-in web server by running \`python3 -m http.server\` in the top level source directory and then navigate to http://localhost:8000/build/debug-emscripten-wasm32/${CLIENT_NAME}.html`);

// What the page says over the game: the download's progress, with a bar
// for a fraction, or an error; nothing hides it. An error stays.
const statusBox = document.getElementById('status');
const statusText = statusBox.querySelector('span');
const statusBar = statusBox.querySelector('progress');
const showStatus = (text, fraction) => {
    if (statusBox.classList.contains('error')) return;
    statusBox.hidden = !text;
    statusText.textContent = text ?? '';
    statusBar.hidden = fraction === undefined;
    if (fraction !== undefined) statusBar.value = fraction;
};
// An error the game can't start after: the page goes no further
const fail = (text) => {
    showStatus(text);
    statusBox.classList.add('error');
    throw new Error(text);
};
const failDownload = (name, response) =>
    fail(`Couldn't download ${name}: ${response ? `the server answered ${response.status}` : 'the connection failed'}.`);

// Ask for WebGL on a canvas of the page's own, before downloading anything:
// a canvas keeps the first kind of context it gives out, and the game's
// must be SDL's to choose
const probe = document.createElement('canvas');
const webgl = probe.getContext('webgl2') ?? (MIN_WEBGL_VERSION < 2 ? probe.getContext('webgl') : null);
webgl?.getExtension('WEBGL_lose_context')?.loseContext();
if (!webgl)
    fail(`This browser can't run the game: it needs WebGL${MIN_WEBGL_VERSION < 2 ? '' : ' 2'}, which is missing or turned off.`);

// First set up the command line arguments and the Emscripten filesystem.
const urlParams = new URLSearchParams(window.location.search);
const com_basegame = urlParams.get('com_basegame') || BASEGAME;
const fs_basegame = urlParams.get('fs_basegame') || '';
const fs_game = urlParams.get('fs_game') || '';
// Set for this visit only. The web's defaults, and a touch device's, are the
// engine's; the canvas has its CSS box's size, and r_mode isn't used
let generatedArguments = `
    +set com_basegame "${com_basegame}"
`;
if (fs_basegame) generatedArguments += ` +set fs_basegame "${fs_basegame}" `;
if (fs_game) generatedArguments += ` +set fs_game "${fs_game}" `;
// ?fullscreen=0 plays this visit in the page's window, and 1 fullscreen
if (urlParams.has('fullscreen')) generatedArguments += ` +set r_fullscreen ${urlParams.get('fullscreen') === '0' ? 0 : 1} `;
// A player's own ?args come after, and win
// Note that unfortunately "+" needs to be encoded as "%2b" in URL query strings or it will be stripped by the browser.
const queryArgs = urlParams.get('args');
if (queryArgs) generatedArguments += ` ${queryArgs} `;

const dataURL = new URL(dataPath, location.origin + location.pathname);

const configPromise = EMSCRIPTEN_PRELOAD_FILE ? Promise.resolve({[BASEGAME]: {files: []}})
  : fetch(configFilename).catch(() => null).then((r) => r?.ok
      ? r.json().catch(() => fail(`Couldn't read ${configFilename}: it isn't valid JSON.`))
      : failDownload(configFilename, r));

// The game takes keys while its canvas has focus; start with it there
canvas.focus();

// Cap the device pixel ratio SDL3 sizes the canvas by at 2 (?maxPixelRatio=):
// a phone at 3 would draw 2.25 times the pixels. It still follows zoom and displays.
const requestedPixelRatio = Number(urlParams.get('maxPixelRatio'));
const maxPixelRatio = requestedPixelRatio > 0 ? requestedPixelRatio : 2;
const pixelRatio = Object.getOwnPropertyDescriptor(window, 'devicePixelRatio')
    ?? Object.getOwnPropertyDescriptor(Window.prototype, 'devicePixelRatio');
if (pixelRatio?.get)
    Object.defineProperty(window, 'devicePixelRatio', {
        configurable: true,
        get: () => Math.min(pixelRatio.get.call(window), maxPixelRatio),
    });

// Raw mouse input on Windows, as the native client has there (?rawMouse=0
// or 1 overrides): without it, Chromium on Windows sometimes reports a huge
// movementY that snaps the view straight up or down. Elsewhere the system's
// own motion, as natively on macOS. A browser without raw input either
// ignores the option or rejects the request with NotSupportedError; only
// that rejection falls back to a plain lock. Other failures, such as a
// request made during a fullscreen change, must not quietly downgrade to it.
const rawMouse = urlParams.has('rawMouse') ? urlParams.get('rawMouse') !== '0' : /Windows/.test(navigator.userAgent);
const lockPointer = () => canvas.requestPointerLock(rawMouse ? { unadjustedMovement: true } : undefined)?.catch?.((e) => {
    if (rawMouse && e?.name === 'NotSupportedError')
        canvas.requestPointerLock()?.catch?.(() => {});
});
const locked = () => document.pointerLockElement === canvas;

// The WebGL context SDL creates, which has no attributes of its own for
// these: the fast GPU where there are two; an opaque canvas, since the
// frame's alpha is the renderer's own business, and a blend that zeroes
// it, as a burn mark's does, showed the black page through as a hard-edged
// hole; and with ?desynchronized, frames drawn straight to the screen
// rather than through the page's compositor, a frame sooner, where the
// browser can (it may tear, or ignore it).
const getContext = HTMLCanvasElement.prototype.getContext;
const desynchronized = urlParams.has('desynchronized');
HTMLCanvasElement.prototype.getContext = function (type, attributes) {
    if (type === 'webgl' || type === 'webgl2')
        attributes = { ...attributes, alpha: false, powerPreference: 'high-performance', ...(desynchronized && { desynchronized }) };
    return getContext.call(this, type, attributes);
};

// The page owns browser fullscreen and the pointer lock, which a browser
// grants only on the player's input, and the engine says whether the player
// wants fullscreen and the game the pointer (Module.present, cl_present.c
// and sdl_input.c): the page goes fullscreen at once if the player's input
// allows, as with the menu's click, or else on their next click, which also
// takes the lock, and reports what is (Module.presentationFacts). A request
// for fullscreen stands until it's met: leaving fullscreen by the browser's
// means, even with a click a moment later, doesn't bring it back, and the
// engine stops wanting it for this visit. The lock is asked for at each
// click without it.
// The whole page goes fullscreen, the canvas following its size. Locking the
// pointer in the click that asks for fullscreen fails in Safari, so the
// lock is asked for once fullscreen is granted. iOS has none: its
// fullscreen ends on a downward swipe, which playing by touch does all the
// time.
const iOS = /iPad|iPhone|iPod/.test(navigator.userAgent)
    || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
// for what a browser does with fullscreen's keys, and says of them
const browser = /Firefox\//.test(navigator.userAgent) ? 'firefox' : /Chrome\//.test(navigator.userAgent) ? 'chromium'
    : /Safari\//.test(navigator.userAgent) ? 'safari' : 'other';
const mac = /Macintosh/.test(navigator.userAgent);
const fullscreenAvailable = !iOS && !!document.documentElement.requestFullscreen;
// The browser's own fullscreen (F11 in Chrome, Edge and Firefox on Windows
// and Linux) isn't the page's, and only the browser's key leaves it: it's
// reported as fullscreen all the same, the platform's own. It's told from
// the page's by beginning without it: the media query may match in the
// page's fullscreen too, and lag its end.
const browserFullscreen = matchMedia('(display-mode: fullscreen)');
let browsersOwn = browserFullscreen.matches;
const isFullscreen = () => Boolean(document.fullscreenElement) || browsersOwn;
// the facts' bits, as sdl_input.c reads them
const FACT_FULLSCREEN = 1, FACT_AVAILABLE = 2, FACT_LOCKED = 4, FACT_POINTER = 8, FACT_ASKED = 16, FACT_ASKED_FULL = 32,
    FACT_ANSWER_SHIFT = 6;
const ANSWER_NONE = 0, ANSWER_CLICK = 1, ANSWER_REFUSED = 2, ANSWER_BROWSERS_OWN = 3;
let wantFullscreen = false, fullscreenAnswer = ANSWER_NONE, wantPointer = false;
// a request out, which a second one would only get in the way of; and
// leaving that the game asked for, which needs no hint
let entering = false, leaving = false;
const enterFullscreen = () => {
    if (entering) return;
    entering = true;
    fullscreenAnswer = ANSWER_NONE;
    document.documentElement.requestFullscreen()
        .then(() => { if (wantPointer) lockPointer(); })
        .catch(() => {
            if (document.fullscreenElement) return;
            // the request stands; the lock needn't wait for it
            fullscreenAnswer = ANSWER_REFUSED;
            if (wantPointer) lockPointer();
        })
        .finally(() => { entering = false; });
};
const exitFullscreen = () => {
    leaving = true;
    document.exitFullscreen().catch(() => { leaving = false; });
};
const present = ({ fullscreen, pointer }) => {
    if (fullscreen !== undefined) {
        fullscreenAnswer = ANSWER_NONE;
        wantFullscreen = fullscreen && fullscreenAvailable && !isFullscreen();
        if (wantFullscreen) {
            if (navigator.userActivation?.isActive ?? false) enterFullscreen();
            else fullscreenAnswer = ANSWER_CLICK;
        } else if (!fullscreen) {
            if (document.fullscreenElement) exitFullscreen();
            else if (browsersOwn) fullscreenAnswer = ANSWER_BROWSERS_OWN;
        }
    }
    if (pointer !== undefined) {
        wantPointer = pointer;
        if (!wantPointer && locked()) document.exitPointerLock();
        showPlay();
    }
};
// The game's sound (snd_web.c): the engine decides what plays, as its base
// backend does, and sends what changed once a frame (update), which answers
// whether the sound runs. Each sound is an AudioBuffer here, outside the
// engine's memory; each channel a strip, a splitter into two gains, left and
// right, as the base mixer's volumes; and each playing sound a source node
// into its channel's strip, mixed by the browser on its audio thread. The
// page makes the one AudioContext in the player's first input, at the
// smallest latency the browser gives, so the browser has no context to
// refuse or warn about, and resumes it in a later input if the browser held
// it. Until it runs, the engine starts nothing, and a stream's samples are
// dropped rather than held to play at once. Its listeners come before the
// presentation's below, which keep the clicks they claim from the rest.
const sound = (() => {
    const buffers = [], strips = [], streams = [];
    let context = null, master = null, merger = null;
    const STATES = ['suspended', 'running', 'closed', 'interrupted'];
    function ended() {
        this.disconnect();
        if (this.strip?.source === this) this.strip.source = null;
        streams[this.stream]?.delete(this);
    }
    const stop = (source) => {
        source.onended = null;
        try { source.stop(); } catch { /* never started */ }
        source.disconnect();
    };
    const strip = (i) => {
        if (!strips[i]) {
            // a mono sound to both gains, as the base mixer plays it: the
            // input mixes it up to stereo, which a splitter, always
            // discrete, would not
            const input = new GainNode(context, { channelCount: 2, channelCountMode: 'explicit', channelInterpretation: 'speakers' });
            const split = new ChannelSplitterNode(context, { numberOfOutputs: 2 });
            const left = new GainNode(context, { gain: 0 }), right = new GainNode(context, { gain: 0 });
            input.connect(split);
            split.connect(left, 0);
            split.connect(right, 1);
            left.connect(merger, 0, 0);
            right.connect(merger, 0, 1);
            strips[i] = { input, left, right, source: null };
        }
        return strips[i];
    };
    const stopStrip = (s) => {
        if (!s?.source) return;
        stop(s.source);
        s.source = null;
    };
    const stopStream = (i) => {
        streams[i]?.forEach(stop);
        streams[i] = undefined;
    };
    const begin = (event) => {
        // with no userActivation, any trusted input is let try
        if (!event.isTrusted || (navigator.userActivation && !navigator.userActivation.isActive)) return;
        if (!context) {
            try {
                context = new AudioContext({ latencyHint: 0 });
            } catch {
                context = new AudioContext();
            }
            master = new GainNode(context, { gain: 0 });
            merger = new ChannelMergerNode(context, { numberOfInputs: 2 });
            merger.connect(master);
            master.connect(context.destination);
        }
        if (context.state !== 'running') context.resume().catch(() => {});
    };
    for (const type of ['pointerdown', 'keydown', 'touchend']) addEventListener(type, begin, { capture: true });
    // A hidden page's sound waits: the game draws no frames there, and a
    // loop would play on alone. Shown again it resumes, or at the next input
    // where the browser wants one (Safari, after an interruption). The
    // engine sees it stop and start, and plays what the game's time has.
    document.addEventListener('visibilitychange', () => {
        if (!context) return;
        if (document.hidden) context.suspend().catch(() => {});
        else if (context.state !== 'running') context.resume().catch(() => {});
    });
    return {
        state: () => context ? STATES.indexOf(context.state) + 1 : 0,
        rate: () => context?.sampleRate ?? 0,
        latency: () => context ? context.baseLatency + (context.outputLatency || 0) : 0,
        // a sound's samples, a channel after another
        load(id, samples, frames, channels, rate) {
            let buffer;
            try {
                // a rate the browser can't hold leaves the sound silent
                buffer = new AudioBuffer({ numberOfChannels: channels, length: Math.max(frames, 1), sampleRate: rate });
            } catch {
                buffers[id] = undefined;
                return;
            }
            for (let c = 0; c < channels; c++) buffer.copyToChannel(samples.subarray(c * frames, (c + 1) * frames), c);
            buffers[id] = buffer;
        },
        // snd_web.c's operations: op, strip, then its values
        update(commands) {
            if (!context) return false;
            for (let k = 0; k < commands.length; k += 6) {
                const s = commands[k + 1];
                switch (commands[k]) {
                case 0: { // start: sfx, offset, loop, rate
                    const buffer = buffers[commands[k + 2]];
                    if (!buffer) break;
                    const loop = Boolean(commands[k + 4]), offset = commands[k + 3];
                    const into = strip(s);
                    stopStrip(into);
                    const source = new AudioBufferSourceNode(context, { buffer, loop, playbackRate: commands[k + 5] });
                    source.strip = into;
                    source.onended = ended;
                    source.connect(into.input);
                    source.start(0, loop ? offset % buffer.duration : Math.max(offset, 0));
                    into.source = source;
                    break;
                }
                case 1: stopStrip(strips[s]); break;
                case 2: {
                    const into = strip(s);
                    into.left.gain.value = commands[k + 2] / 256;
                    into.right.gain.value = commands[k + 3] / 256;
                    break;
                }
                case 3: if (strips[s]?.source) strips[s].source.playbackRate.value = commands[k + 2]; break;
                case 4: master.gain.value = commands[k + 2]; break;
                }
            }
            return context.state === 'running';
        },
        // a stream's samples, left then right, with their gains in them,
        // after its last
        stream(i, samples, frames, rate) {
            if (context?.state !== 'running' || !frames) {
                stopStream(i);
                return;
            }
            let buffer;
            try {
                buffer = new AudioBuffer({ numberOfChannels: 2, length: frames, sampleRate: rate });
            } catch {
                return;
            }
            buffer.copyToChannel(samples.subarray(0, frames), 0);
            buffer.copyToChannel(samples.subarray(frames), 1);
            const queued = streams[i] ??= new Set();
            const source = new AudioBufferSourceNode(context, { buffer });
            source.stream = i;
            source.onended = ended;
            source.connect(master);
            // back to back, or a moment from now if it ran out
            const at = Math.max(queued.next ?? 0, context.currentTime + 0.02);
            source.start(at);
            queued.next = at + buffer.duration;
            queued.add(source);
        },
        stopStream,
        stopAll() {
            strips.forEach(stopStrip);
            streams.forEach((_, i) => stopStream(i));
        },
    };
})();

// A click that goes fullscreen or takes the lock is the page's, never the
// game's: SDL sees neither its press nor its release, which Safari's change
// to fullscreen could lose, leaving the gun firing. A touch is the game's.
// A claimed release that never came is forgotten at the next press, whose
// release is then the game's.
let claimedPointer;
addEventListener('pointerdown', (event) => {
    if (event.pointerType !== 'mouse') return;
    claimedPointer = undefined;
    if (event.target !== canvas) return;
    const goFullscreen = wantFullscreen && !isFullscreen();
    const takeLock = wantPointer && !locked();
    if (!goFullscreen && !takeLock) return;
    event.stopImmediatePropagation();
    claimedPointer = event.pointerId;
    if (goFullscreen) enterFullscreen();
    else lockPointer();
}, { capture: true });
addEventListener('pointerup', (event) => {
    if (event.pointerId !== claimedPointer) return;
    claimedPointer = undefined;
    event.stopImmediatePropagation();
}, { capture: true });
// The mouse's motion is the game's only under the lock. As the lock ends
// (Esc, leaving fullscreen) the browser puts the cursor back where it was,
// which SDL would pass on as one long move, and the engine, learning of the
// loss a frame later, would turn the view by it: while the game wants the
// lock and hasn't got it, the motion stays the page's.
for (const type of ['pointermove', 'mousemove'])
    addEventListener(type, (event) => {
        if (wantPointer && !locked() && (event.pointerType ?? 'mouse') === 'mouse') event.stopImmediatePropagation();
    }, { capture: true });
// Safari bundles a frame's mouse moves into one pointermove whose movement
// is only the last move's, not their sum, so under the lock most of the
// mouse's motion was lost (WebKit bug 235116). Where an event shows that,
// its movement becomes the sum of its bundled moves before SDL reads it;
// browsers that sum already are left alone. Not with raw input, where
// Safari makes only the event's own movement raw.
addEventListener('pointermove', (event) => {
    if (rawMouse || event.pointerType !== 'mouse' || !locked()) return;
    const moves = event.getCoalescedEvents?.() ?? [];
    const last = moves.at(-1);
    if (moves.length < 2 || event.movementX !== last.movementX || event.movementY !== last.movementY) return;
    const sum = (axis) => moves.reduce((total, move) => total + move[axis], 0);
    Object.defineProperties(event, { movementX: { value: sum('movementX') }, movementY: { value: sum('movementY') } });
}, { capture: true });

// Alt+Enter (Option+Return on a Mac) is the page's too: Firefox grants
// fullscreen only while the key is handled, and the engine reads its keys a
// frame later. The page asks for the other of what's on screen at the key,
// SDL sees neither its press nor its release, and the engine is told what
// was asked, as the player's own request, which it saves (cl_present.c).
// A claimed release that never came is forgotten at the next press, as a
// click's is.
let asked = 0, claimedEnter = false;
addEventListener('keydown', (event) => {
    if (event.code !== 'Enter') return;
    claimedEnter = false;
    if (event.target !== canvas || !event.altKey) return;
    event.stopImmediatePropagation();
    event.preventDefault();
    claimedEnter = true;
    if (event.repeat) return;
    const fullscreen = !isFullscreen();
    asked = FACT_ASKED | (fullscreen ? FACT_ASKED_FULL : 0);
    present({ fullscreen });
}, { capture: true });
addEventListener('keyup', (event) => {
    if (event.code !== 'Enter' || !claimedEnter) return;
    claimedEnter = false;
    event.stopImmediatePropagation();
}, { capture: true });

// The page's hints: the timed ones, held about four seconds, and each only
// the first time in a visit; and "Click to play", while the game wants the
// pointer in a match and doesn't have it. It stays up through a click the
// browser refuses, as Chrome does for a second or two after the player's
// Esc in a window, and says nothing more.
const hintBox = document.getElementById('hint');
const playBox = document.getElementById('play');
const hinted = new Set();
let hintTimer, playing = false;
const fade = (box, text) => {
    if (text) box.textContent = text;
    box.classList.toggle('shown', Boolean(text));
};
for (const box of [hintBox, playBox])
    box.addEventListener('transitionend', () => { if (!box.classList.contains('shown')) box.textContent = ''; });
const hintOnce = (text) => {
    if (hinted.has(text)) return;
    hinted.add(text);
    fade(hintBox, text);
    clearTimeout(hintTimer);
    hintTimer = setTimeout(() => fade(hintBox), 4000);
};
const showPlay = () => fade(playBox, playing && wantPointer && !locked() ? 'Click to play' : '');
document.addEventListener('pointerlockchange', showPlay);

// In the page's fullscreen, Esc and F11 are the game's where the browser has
// Keyboard Lock (Chrome, and Safari from 26.4): Esc opens the menu, as
// natively, F11 takes a screenshot, and a held Esc leaves fullscreen. The
// browser lets go of the keys as fullscreen ends. Chrome says how to leave
// itself, as Firefox does, where the page's hint would go; elsewhere the
// page says it: with Keyboard Lock a held Esc, and without it, in Safari,
// one Esc frees the pointer and a second leaves. On leaving, by any means
// but the game's, it says how to come back.
const keyboardLock = navigator.keyboard?.lock ? navigator.keyboard : null;
// The hint waits for the lock's answer: a refused lock leaves Esc the
// browser's.
const hintLeaving = (keysLocked) => {
    const hint = browser === 'chromium' || browser === 'firefox' ? ''
        : keysLocked ? 'Hold Esc to leave fullscreen'
        : browser === 'safari' && wantPointer ? 'Press Esc twice to leave fullscreen'
        : 'Press Esc to leave fullscreen';
    if (hint && document.fullscreenElement) hintOnce(hint);
};
document.addEventListener('fullscreenchange', () => {
    if (document.fullscreenElement) {
        wantFullscreen = false;
        if (keyboardLock) keyboardLock.lock(['Escape', 'F11']).then(() => hintLeaving(true), () => hintLeaving(false));
        else hintLeaving(false);
    } else {
        keyboardLock?.unlock();
        if (!leaving) hintOnce(mac ? 'Option+Return for fullscreen' : 'Alt+Enter for fullscreen');
        leaving = false;
    }
});
// The browser's own fullscreen fires no fullscreenchange: entering it meets
// a standing request, so leaving it by its key doesn't make a click go in.
browserFullscreen.addEventListener('change', () => {
    browsersOwn = browserFullscreen.matches && !document.fullscreenElement;
    if (browsersOwn) wantFullscreen = false;
});

// as bits, for the engine to read each frame (IN_PresentFacts); Alt+Enter's
// request only once
// a mouse or the like, which the lock is for; a touch screen has none
const finePointer = matchMedia('(any-pointer: fine)');
const presentationFacts = () => {
    const facts = (isFullscreen() ? FACT_FULLSCREEN : 0)
        | (fullscreenAvailable ? FACT_AVAILABLE : 0)
        | (locked() ? FACT_LOCKED : 0)
        | (finePointer.matches ? FACT_POINTER : 0)
        | asked
        | (fullscreenAnswer << FACT_ANSWER_SHIFT);
    asked = 0;
    return facts;
};

// A right click is the game's. SDL leaves the event be, and the browser's
// menu would open over the game while the pointer is free: on the menus,
// and with the console down.
canvas.addEventListener('contextmenu', (event) => event.preventDefault());

// A player in a match is asked before the page closes or reloads, and one on
// the menu isn't; the engine says when a match starts and ends (CL_Frame).
// The listener is there only meanwhile: a browser may leave a page with one
// out of its back-forward cache.
const confirmLeave = (event) => {
    event.preventDefault();
    event.returnValue = '';
};
const setPlaying = (inMatch) => {
    playing = inMatch;
    if (playing) addEventListener('beforeunload', confirmLeave);
    else removeEventListener('beforeunload', confirmLeave);
    showPlay();
};

// The engine's files live in the page's memory: a screenshot it writes
// is handed to the player as a download (FS_WriteFile), named for when it
// was taken, since the engine keeps no copy and so names every one shot0000
const saveFile = (path, bytes) => {
    const stamp = new Date().toISOString().slice(0, 19).replace(/[-:T]/g, '');
    const link = document.createElement('a');
    link.href = URL.createObjectURL(new Blob([bytes]));
    link.download = `@CLIENT_BINARY@-${stamp}.${path.split('.').pop()}`;
    link.click();
    setTimeout(() => URL.revokeObjectURL(link.href), 10000);
};

// The home, Emscripten's HOME, where the engine keeps its config, the
// console's history and recorded demos, is kept in the browser's storage
// between visits. It's read back before the engine starts, and saved when
// the engine writes its config and when the page is hidden or closed,
// which may be the last chance. Only once it was read, or the first save
// would replace what's stored with a new home. A browser that won't store
// it, as in some private windows, plays without.
const HOME = '/home/web_user';
let homeFS, saving = false, saveAgain = false;
const saveHome = () => {
    if (!homeFS) return;
    if (saving) {
        saveAgain = true;
        return;
    }
    saving = true;
    homeFS.syncfs(false, (error) => {
        if (error) console.warn(`Couldn't save the settings: ${error}`);
        saving = false;
        if (saveAgain) {
            saveAgain = false;
            saveHome();
        }
    });
};
// The config is written whenever a setting changes, every frame while a
// slider is dragged: save a second after the last write
let configSave = 0;
const configWritten = () => {
    clearTimeout(configSave);
    configSave = setTimeout(saveHome, 1000);
};
document.addEventListener('visibilitychange', () => { if (document.hidden) saveHome(); });
addEventListener('pagehide', saveHome);

// Download the files the config lists for the game, all at once, showing
// their progress against the sizes the server gives. A pak that's missing
// is an error; other files may be, such as the QVMs a build that links its
// game code doesn't need. A failure stops the rest.
const megabytes = (bytes) => Math.round(bytes / 1e6);
const downloadGame = async (FS) => {
    const config = await configPromise;
    const files = [com_basegame, fs_basegame, fs_game].filter((gamedir) => gamedir).flatMap((gamedir) => {
        if (config[gamedir]?.files) return config[gamedir].files;
        console.warn(`Game directory '${gamedir}' cannot be used. It must have files listed in ${configFilename}.`);
        return [];
    });
    const downloading = new AbortController();
    const stop = (name, response) => {
        downloading.abort();
        failDownload(name, response);
    };
    const responses = await Promise.all(files.map((file) =>
        fetch(new URL(file.src, dataURL), { signal: downloading.signal }).catch(() => null)));
    const downloads = [];
    let received = 0, total = 0, sized = true;
    responses.forEach((response, i) => {
        const { src } = files[i];
        if (response?.status === 404 && !/\.pk3$/i.test(src)) {
            console.warn(`${src} isn't on the server; skipped`);
            return;
        }
        if (!response?.ok) stop(src, response);
        // a compressed response's length isn't what it reads as
        const length = Number(response.headers.get('Content-Length'));
        if (length > 0 && !response.headers.has('Content-Encoding')) total += length;
        else sized = false;
        downloads.push({ ...files[i], response, length });
    });
    // when a whole megabyte or hundredth more is in, so the bar ends full
    let shown = '';
    const progress = () => {
        const bytes = sized ? Math.min(received, total) : received;
        const text = `Downloading the game: ${megabytes(bytes)}${sized ? ` of ${megabytes(total)}` : ''} MB`;
        const fraction = sized ? Math.floor(100 * bytes / total) / 100 : undefined;
        if (`${text} ${fraction}` === shown) return;
        shown = `${text} ${fraction}`;
        showStatus(text, fraction);
    };
    if (downloads.length) progress();
    await Promise.all(downloads.map(async ({ src, dst, response, length }) => {
        // into one buffer of the size given, grown if that's wrong
        let data = new Uint8Array(length), size = 0;
        try {
            const reader = response.body.getReader();
            for (;;) {
                const { done, value } = await reader.read();
                if (done) break;
                if (size + value.length > data.length) {
                    const grown = new Uint8Array(Math.max(2 * data.length, size + value.length));
                    grown.set(data.subarray(0, size));
                    data = grown;
                }
                data.set(value, size);
                size += value.length;
                received += value.length;
                progress();
            }
        } catch {
            stop(src);
        }
        FS.mkdirTree(dst);
        // the page keeps no copy, so the file system can take this one, cut
        // to size if it was grown
        FS.writeFile(`${dst}/${src.match(/[^/]+$/)[0]}`, size < data.length ? data.slice(0, size) : data, { canOwn: true });
    }));
};

const ioquake3 = (await import(enginePath + `@CLIENT_BINARY@.js`)).default;
ioquake3({
    canvas: canvas,
    present,
    presentationFacts,
    sound,
    setPlaying,
    saveFile,
    configWritten,
    arguments: generatedArguments.trim().split(/\s+/),
    locateFile: (file) => enginePath + file,
    preRun: [(module) => {
        module.FS.mount(module.FS.filesystems.IDBFS, {}, HOME);
        module.addRunDependency('load-home');
        module.FS.syncfs(true, (error) => {
            if (error) console.warn(`Couldn't read the settings saved before: ${error}`);
            else homeFS = module.FS;
            module.removeRunDependency('load-home');
        });
    }, async (module) => {
        // a download that fails leaves the engine waiting, under its error
        module.addRunDependency('setup-ioq3-filesystem');
        await downloadGame(module.FS);
        showStatus('Starting…');
        module.removeRunDependency('setup-ioq3-filesystem');
    }],
    // a player who quit isn't asked before closing the page
    onExit: () => setPlaying(false),
    // the engine has started, and draws from here on
    postRun: [() => showStatus()],
});
</script>
